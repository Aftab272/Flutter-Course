# LootifyScrap Backend API Configuration
# Copy this file to .env and populate your official API credentials.
# NEVER commit .env or expose these secrets in Flutter frontend code.

PORT=8000

# 1. Etsy Open API v3 (https://www.etsy.com/developers)
ETSY_API_KEY=

# 2. eBay Browse API (https://developer.ebay.com)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# 3. Amazon Product Advertising API 5.0 / Rainforest API
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
RAINFOREST_API_KEY=

# 4. Shopify Storefront (Public /products.json works automatically; optional token for private Storefront GraphQL)
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_DEFAULT_STORES=allbirds.com,gymshark.com,ridge.com,fellowproducts.com

# 5. Keyword Intelligence Provider (DataForSEO - https://dataforseo.com)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
